/*
 * native_sim: the same nodes and aliases as on the ESP32-S3, backed by
 * emulators: uart-emul for the sign and the MH-Z19B, i2c-emul for the
 * BME280, gpio-emul for the lamp key, LED and button, and the flash
 * simulator with the same partition names.
 */
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	chosen {
		ws,sign-uart = &sign_uart;
	};

	aliases {
		ws-lamp = &lamp_key;
		ws-led = &status_led;
		ws-button = &svc_button;
		ws-co2 = &mhz19b;
		ws-thp = &bme280;
	};

	ws_outputs {
		compatible = "gpio-leds";
		lamp_key: lamp_key {
			gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
			label = "Lamp key";
		};
		status_led: status_led {
			gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
			label = "Status LED";
		};
	};

	ws_buttons: ws_buttons {
		compatible = "gpio-keys";
		debounce-interval-ms = <30>;
		svc_button: svc_button {
			gpios = <&gpio0 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Service button";
			zephyr,code = <INPUT_KEY_MENU>;
		};
	};

	/* RS-485 line to the sign: TX only, read back by the test sniffer */
	sign_uart: uart_emul_sign {
		compatible = "zephyr,uart-emul";
		status = "okay";
		current-speed = <4800>;
		tx-fifo-size = <1024>;
		rx-fifo-size = <16>;
	};

	co2_uart: uart_emul_co2 {
		compatible = "zephyr,uart-emul";
		status = "okay";
		current-speed = <9600>;
		tx-fifo-size = <64>;
		rx-fifo-size = <64>;

		mhz19b: mhz19b {
			compatible = "winsen,mhz19b";
			maximum-range = <5000>;
		};
	};

	fstab {
		compatible = "zephyr,fstab";
		lfs1: lfs1 {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs";
			partition = <&lfs_partition>;
			automount;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};

&i2c0 {
	bme280: bme280@76 {
		compatible = "bosch,bme280";
		reg = <0x76>;
	};
};

/* Same partition names as on the device, smaller slots. */
/delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;
/delete-node/ &scratch_partition;
/delete-node/ &storage_partition;

&flashcontroller0 {
	reg = <0x00000000 DT_SIZE_M(4)>;
};

&flash0 {
	reg = <0x00000000 DT_SIZE_M(4)>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(64)>;
		};
		slot0_partition: partition@10000 {
			label = "image-0";
			reg = <0x00010000 DT_SIZE_M(1)>;
		};
		slot1_partition: partition@110000 {
			label = "image-1";
			reg = <0x00110000 DT_SIZE_M(1)>;
		};
		storage_partition: partition@210000 {
			label = "storage";
			reg = <0x00210000 DT_SIZE_K(64)>;
		};
		lfs_partition: partition@220000 {
			label = "littlefs";
			reg = <0x00220000 DT_SIZE_M(1)>;
		};
	};
};
